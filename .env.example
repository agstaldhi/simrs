APP_NAME="SIMRS - Sistem Informasi Manajemen Rumah Sakit"
APP_ENV=development
APP_URL=http://localhost
APP_DEBUG=true

DB_DSN="mysql:host=localhost;dbname=simrs;charset=utf8mb4"
