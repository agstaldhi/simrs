DB_PASS=""

# Secret key for SQL backup encryption (needs to be 32 characters or longer)
DB_BACKUP_KEY=6f9b8c7d6e5a4f3b2a1c0d9e8f7a6b5c

# BPJS KESEHATAN INTEGRATION
BPJS_ENABLED=false
BPJS_BASE_URL="https://apijkn-dev.bpjs-kesehatan.go.id/vclaim-rest-dev"
BPJS_CONS_ID="12345"
BPJS_SECRET_KEY="mysecretkey"
BPJS_USER_KEY_VCLAIM="userkeyvclaim"
BPJS_USER_KEY_ANTREAN="userkeyantrean"

# KEMENKES SATUSEHAT INTEGRATION
SATUSEHAT_ENABLED=false
